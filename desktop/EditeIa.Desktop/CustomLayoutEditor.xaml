<UserControl x:Class="EditeIa.Desktop.CustomLayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="780"
             SizeChanged="CustomLayoutEditor_SizeChanged">
    <Border BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Background="{StaticResource Brush.CardBg}">
        <Grid x:Name="LayoutRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColFrame" Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="ColMidGap" Width="14" />
                <ColumnDefinition x:Name="ColPreview" Width="Auto" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="12"
                       Text="Capturá un fotograma. Verde = cámara, ámbar = juego: arrastrá para mover; esquinas y bordes para agrandar o achicar. Vista previa 9:16 a la derecha." />

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <Button x:Name="CaptureBtn"
                        Content="Capturar fotograma"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,8"
                        Margin="0,0,10,0"
                        Click="CaptureBtn_Click" />
                <TextBlock x:Name="FrameStatusText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Text="Sin fotograma. Elegí video y pulsá capturar." />
            </StackPanel>

            <Border x:Name="FrameHost"
                    Grid.Row="2"
                    Grid.Column="0"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="Black"
                    HorizontalAlignment="Stretch"
                    MinHeight="140"
                    MaxHeight="400"
                    ClipToBounds="True">
                <Viewbox x:Name="FrameViewbox"
                         Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Visibility="Collapsed">
                    <Grid x:Name="FrameRoot" SnapsToDevicePixels="True">
                        <Image x:Name="FrameImage"
                               Stretch="Fill"
                               IsHitTestVisible="False" />
                        <Canvas x:Name="OverlayCanvas"
                                Background="Transparent"
                                MouseLeftButtonDown="OverlayCanvas_OnMouseDown"
                                MouseMove="OverlayCanvas_OnMouseMove"
                                MouseLeftButtonUp="OverlayCanvas_OnMouseUp"
                                MouseLeave="OverlayCanvas_OnMouseLeave" />
                    </Grid>
                </Viewbox>
            </Border>

            <StackPanel x:Name="PreviewPanel"
                        Grid.Row="2"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        MinWidth="120">
                <TextBlock Text="Vista previa 9:16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         MaxWidth="160"
                         HorizontalAlignment="Center">
                    <Border BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Width="126"
                            Height="224"
                            Background="#0D0D14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.3*" />
                                <RowDefinition Height="0.7*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="Black">
                                <Image x:Name="PreviewTop"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="Black">
                                <Image x:Name="PreviewBottom"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>
                <TextBlock Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Vista previa fiel al rectángulo (30% / 70%). Salida con bandas si el ratio no coincide." />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
